      <Box style={{ width: 370, height: 360, background: '#1E4FA8', padding: 22, display: 'flex', flexDirection: 'column' }}>
        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#DCE7F7' }}>TAKEAWAY</Text>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', marginTop: 4 }}>可以带走的结论</Text>
        <Box style={{ height: 1, background: '#6E8FC7', marginTop: 14, marginBottom: 4 }} />
